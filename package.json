{
  "name": "servfex-admin-be",
  "version": "1.0.0",
  "description": "ServFex Super Admin Backend REST API",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "postinstall": "prisma generate",
    "prebuild": "prisma generate",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:push": "prisma db push",
    "prisma:seed": "ts-node prisma/seed.ts",
    "seed": "ts-node prisma/seed.ts",
    "seed:uc-catalog": "ts-node --transpile-only prisma/seed_uc_catalog.ts",
    "test": "node --test tests/*.test.cjs"
  },
  "keywords": [
    "servfex",
    "admin",
    "api",
    "prisma",
    "mongodb",
    "express"
  ],
  "author": "ServFex Team",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "agora-token": "^2.0.7",
    "argon2": "^0.41.1",
    "axios": "^1.21.0",
    "cloudinary": "^2.11.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "decimal.js": "^10.5.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "firebase-admin": "^14.4.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.1.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "prisma": "^6.4.1",
    "socket.io": "^4.8.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^22.13.4",
    "@types/nodemailer": "^8.0.2",
    "rimraf": "^6.0.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3"
  }
}
