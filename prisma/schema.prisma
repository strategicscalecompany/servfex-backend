// ServFex Master Prisma Schema
// Single source of truth for MongoDB Atlas

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum UserRole {
  SUPER_ADMIN
  CUSTOMER
  VENDOR
  EMPLOYEE
  OPERATIONS_MANAGER
}

enum ManagerKind {
  OPERATIONS
  BUSINESS_DEVELOPMENT
}

enum BookingSource {
  CUSTOMER_APP
  EXPERT_TEAM
  PHONE_HUB
  SALES_MANAGER
}

/// Temporary testing-workflow expert classification. Existing employees default to SERVICE_PROFESSIONAL
/// so the original job-assignment behaviour is preserved when the flag is off.
enum ExpertKind {
  SERVICE_PROFESSIONAL
  SALES_MANAGER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_APPROVAL
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BookingStatus {
  PENDING
  ACCEPTED
  ASSIGNED
  ON_THE_WAY
  ARRIVED
  IN_PROGRESS
  AWAITING_CUSTOMER_CONFIRMATION
  AWAITING_PAYMENT
  COMPLETED
  CANCELLED
  DECLINED
  DISPUTED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  ONLINE
  CASH
  UPI
  CARD
  WALLET
}

enum RefundStatus {
  PENDING
  COMPLETED
  FAILED
}

enum DocumentType {
  GOVERNMENT_ID
  TRADE_LICENSE
  TAX_DOCUMENT
  CERTIFICATE
  OTHER
}

enum AssignmentMethod {
  PROVIDER
  AUTO
}

enum AssignmentStatus {
  OFFERED
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum CallStatus {
  RINGING
  ACTIVE
  ENDED
  MISSED
  DECLINED
}

enum NotificationTarget {
  ALL
  CUSTOMERS
  VENDORS
  EMPLOYEES
  SPECIFIC_USER
}

// ==========================================
// IDENTITY & USERS
// ==========================================

model User {
  id              String      @id @default(uuid()) @map("_id")
  firebaseUid     String?     @unique
  email           String      @unique
  phone           String?     @unique
  passwordHash    String?
  name            String
  role            UserRole    @default(CUSTOMER)
  status          UserStatus  @default(ACTIVE)
  profilePhotoUrl String?
  isVerified      Boolean     @default(false)
  lastLoginAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?

  // Profile relations
  customerProfile CustomerProfile?
  vendorProfile   VendorProfile?
  employeeProfile EmployeeProfile?
  managerProfile  ManagerProfile?

  // General relations
  addresses       UserAddress[]
  documents       Document[]
  sessions        Session[]
  auditLogs       AuditLog[]        @relation("AdminAuditLogs")
  reviewsWritten  Review[]          @relation("CustomerReviews")
  feedbackGiven   EmployeeFeedback[] @relation("FeedbackGiven")

  @@index([role])
  @@index([status])
  @@index([deletedAt])
}

model Session {
  id          String   @id @default(uuid()) @map("_id")
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String   @unique
  ipAddress   String?
  userAgent   String?
  isValid     Boolean  @default(true)
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

model CustomerProfile {
  id               String   @id @default(uuid()) @map("_id")
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalBookings    Int      @default(0)
  totalSpent       String   @default("0.00") // 2-decimal rupees; Prisma Mongo has no Decimal128
  emergencyContact String?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  bookings         Booking[] @relation("CustomerBookings")
}

model VendorProfile {
  id                 String          @id @default(uuid()) @map("_id")
  userId             String          @unique
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName        String
  businessLicense    String?
  taxId              String?
  kycStatus          KycStatus       @default(PENDING)
  kycRejectionReason String?
  location           String
  latitude           Float?
  longitude          Float?
  bio                String?
  rating             Float           @default(5.0)
  reviewCount        Int             @default(0)
  commissionRate     String          @default("15.00") // 2-decimal percent; Prisma Mongo has no Decimal128
  isActive           Boolean         @default(true)
  warehouseName      String?
  warehouseLocation  String?
  warehousePhone     String?
  warehouseImageUrl  String?
  serviceRadiusKm    Float           @default(15)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  employees          EmployeeProfile[]
  managers           ManagerProfile[]
  vendorServices     VendorService[]
  bookings           Booking[]       @relation("VendorBookings")
  reviews            Review[]        @relation("VendorReviews")
  salesVisits        SalesVisit[]

  @@index([kycStatus])
  @@index([isActive])
}

model EmployeeProfile {
  id             String          @id @default(uuid()) @map("_id")
  userId         String          @unique
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendorId       String
  vendor         VendorProfile   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  specialization String
  expertKind     ExpertKind      @default(SERVICE_PROFESSIONAL)
  rating         Float           @default(5.0)
  completedJobs  Int             @default(0)
  phone          String
  isAvailable    Boolean         @default(true)
  lastAssignedAt DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  bookings       Booking[]       @relation("EmployeeBookings")
  reviews        Review[]        @relation("EmployeeReviews")
  feedback       EmployeeFeedback[]
  assignments    BookingAssignment[]
  salesVisits    SalesVisit[]

  @@index([vendorId])
  @@index([isAvailable])
  @@index([vendorId, isAvailable])
  @@index([vendorId, expertKind])
}

model ManagerProfile {
  id         String      @id @default(uuid()) @map("_id")
  userId     String      @unique
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       ManagerKind @default(OPERATIONS)
  zone       String      @default("Central Territory Zone")
  city       String      @default("Hyderabad")
  shiftHours String      @default("09:00 AM - 06:00 PM")
  vendorId   String?
  vendor     VendorProfile? @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([vendorId])
  @@index([kind])
}

model UserAddress {
  id           String    @id @default(uuid()) @map("_id")
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  label        String    @default("Home")
  addressLine1 String
  addressLine2 String?
  landmark     String?
  city         String
  state        String
  postalCode   String
  latitude     Float?
  longitude    Float?
  isDefault    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  bookings     Booking[]

  @@index([userId])
  @@index([userId, isDefault, createdAt(sort: Desc)])
}

// ==========================================
// SERVICES & PACKAGES
// ==========================================

model ServiceCategory {
  id            String               @id @default(uuid()) @map("_id")
  name          String
  slug          String               @unique
  iconUrl       String?              // PNG/JPG Cloudinary URL for category tile
  icon          String?              // DEPRECATED — Lucide icon name, kept for backwards compat
  description   String?
  displayOrder  Int                  @default(0)
  isActive      Boolean              @default(true)
  deletedAt     DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  services      Service[]
  subCategories ServiceSubCategory[]

  @@index([isActive])
  @@index([deletedAt])
}

model ServiceSubCategory {
  id           String          @id @default(uuid()) @map("_id")
  categoryId   String
  category     ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name         String
  iconUrl      String?         // Cloudinary icon/logo URL
  bannerImages String[]        @default([]) // Up to 4 banner images (min 1 required on creation)
  bannerVideo  String?         // Optional 1 video URL
  displayOrder Int             @default(0)
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  services     Service[]

  @@index([categoryId])
  @@index([isActive])
}

model Service {
  id             String              @id @default(uuid()) @map("_id")
  categoryId     String
  category       ServiceCategory     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subCategoryId  String?
  subCategory    ServiceSubCategory? @relation(fields: [subCategoryId], references: [id], onDelete: SetNull)
  name           String
  slug           String              @unique
  description    String
  iconUrl        String?
  imageUrl       String?             // DEPRECATED — kept for backwards compat
  bannerImages   String[]
  bannerVideo    String?
  startingPrice  String // 2-decimal rupees; Prisma Mongo has no Decimal128
  priceUnit      String              @default("per service")
  durationText   String              @default("60 mins")
  rating         Float               @default(5.0)
  reviewCount    Int                 @default(0)
  iconName       String?             // DEPRECATED — Lucide icon name
  isPopular      Boolean             @default(false)
  isActive       Boolean             @default(true)
  deletedAt      DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  packages       ServicePackage[]
  vendorServices VendorService[]
  bookings       Booking[]
  reviews        Review[]

  @@index([categoryId])
  @@index([subCategoryId])
  @@index([isActive])
  @@index([deletedAt])
  @@index([isActive, deletedAt, isPopular, rating(sort: Desc)])
  @@index([categoryId, isActive, deletedAt])
}

model ServicePackage {
  id                 String   @id @default(uuid()) @map("_id")
  serviceId          String
  service            Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  // Identity & listing
  name               String?
  shortDescription   String?
  badgeText          String?

  // Pricing
  originalPrice      String?
  discountedPrice    String?
  savingsLabel       String?
  pricePerUnitLabel  String?
  duration           String   @default("60 mins")

  // Listing card media
  cardImage          String?

  // Detail page banner (up to 4 images)
  detailBannerImages String[]

  // Detail page content
  highlights         String[]
  processSteps       Json     @default("[]")
  whatsIncluded      String[]
  requirements       Json     @default("[]")
  pleaseNote         String[]
  faqs               Json     @default("[]")

  // Meta
  displayOrder       Int      @default(0)
  isPopular          Boolean  @default(false)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Legacy fields — kept for backwards compat
  title              String?
  description        String?
  price              String?
  durationMinutes    Int?     @default(60)
  features           Json?    @default("[]")

  bookings           Booking[]

  @@index([serviceId])
  @@index([isActive])
  @@index([serviceId, isActive, displayOrder])
}

model VendorService {
  id           String        @id @default(uuid()) @map("_id")
  vendorId     String
  vendor       VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  serviceId    String
  service      Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  customPrice  String?
  isActive     Boolean       @default(true)
  availability String        @default("Mon-Sat: 09:00 - 18:00")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([vendorId, serviceId])
  @@index([vendorId])
  @@index([serviceId])
}

// ==========================================
// BOOKINGS & WORKFLOW
// ==========================================

model Booking {
  id                 String               @id @default(uuid()) @map("_id")
  bookingNumber      String               @unique
  customerId         String
  customer           CustomerProfile      @relation("CustomerBookings", fields: [customerId], references: [id], onDelete: Restrict)
  serviceId          String
  service            Service              @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  packageId          String?
  package            ServicePackage?      @relation(fields: [packageId], references: [id], onDelete: SetNull)
  addressId          String
  address            UserAddress          @relation(fields: [addressId], references: [id], onDelete: Restrict)
  vendorId           String?
  vendor             VendorProfile?       @relation("VendorBookings", fields: [vendorId], references: [id], onDelete: SetNull)
  employeeId         String?
  employee           EmployeeProfile?     @relation("EmployeeBookings", fields: [employeeId], references: [id], onDelete: SetNull)

  scheduledDate      String               // YYYY-MM-DD
  scheduledTimeSlot  String               // e.g. 10:00 AM - 12:00 PM

  status             BookingStatus        @default(PENDING)

  basePrice          String
  taxes              String               @default("0.00")
  discountAmount     String               @default("0.00")
  extraCharges       String               @default("0.00")
  totalAmount        String
  expertPayout       String? 
  paymentStatus      PaymentStatus        @default(PENDING)
  paymentMethod      PaymentMethod        @default(ONLINE)
  bookingSource      BookingSource        @default(CUSTOMER_APP)

  notes              String?
  cancellationReason String?
  adminNotes         String?

  // Rapido-style 4-digit start OTP. Stored server-side; returned only to the customer.
  // Legacy column names kept so existing rows and clients keep working.
  qrChallengeToken       String?
  qrChallengeExpiresAt   DateTime?
  qrVerifiedAt           DateTime?
  completionRequestedAt  DateTime?
  customerConfirmedAt    DateTime?
  disputeReason          String?
  disputeReportedAt      DateTime?
  cashCollectedAmount    String?
  cashCollectedAt        DateTime?

  // Customer-confirmed exact service location (pinned on the map). Authoritative for routing & navigation.
  serviceLatitude            Float?
  serviceLongitude           Float?
  serviceFormattedAddress    String?
  serviceLocationNote        String?
  serviceLocationAccuracyM   Float?
  serviceLocationConfirmedAt DateTime?

  // Provider-first assignment window & server-side fallback bookkeeping
  providerDeadlineAt     DateTime?            // createdAt + provider response window (immutable, for UI countdown)
  dispatchDueAt          DateTime?            // next server-side dispatch action: PENDING -> auto-assign due; ASSIGNED -> offer expiry (null = nothing scheduled)
  dispatchAttempts       Int                  @default(0)
  assignmentMethod       AssignmentMethod?
  assignedAt             DateTime?
  acceptedAt             DateTime?
  onTheWayAt             DateTime?
  arrivedAt              DateTime?

  // Hosted completion photograph URLs. Empty for historic bookings; required (min 4) only while the
  // temporary expert testing workflow is enabled.
  completionPhotoUrls    String[]             @default([])

  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  statusHistory      BookingStatusHistory[]
  payments           Payment[]
  refunds            Refund[]
  review             Review?
  assignments        BookingAssignment[]
  calls              BookingCall[]

  @@index([customerId])
  @@index([vendorId])
  @@index([employeeId])
  @@index([status])
  @@index([scheduledDate])
  @@index([createdAt])
  @@index([customerId, createdAt(sort: Desc)])
  @@index([customerId, status, createdAt(sort: Desc)])
  @@index([vendorId, status, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([status, dispatchDueAt])
  @@index([employeeId, status])
  @@index([vendorId, scheduledDate])
  @@index([employeeId, scheduledDate, scheduledTimeSlot])
  @@index([vendorId, bookingSource, createdAt(sort: Desc)])
  @@index([employeeId, scheduledDate(sort: Desc)])
  @@index([vendorId, employeeId, status])
}

/// Lead-generation visit captured by a Sales Manager at a warehouse, hub, or business location.
/// Isolated from Booking so a visit never auto-creates a customer job.
model SalesVisit {
  id             String          @id @default(uuid()) @map("_id")
  employeeId     String
  employee       EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  vendorId       String
  vendor         VendorProfile   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  locationName   String
  addressLine    String
  latitude       Float?
  longitude      Float?
  inChargeName   String
  inChargePhone  String
  inChargeEmail  String?
  photoUrls      String[]
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([employeeId, createdAt(sort: Desc)])
  @@index([vendorId, createdAt(sort: Desc)])
}

model BookingStatusHistory {
  id            String        @id @default(uuid()) @map("_id")
  bookingId     String
  booking       Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  oldStatus     BookingStatus?
  newStatus     BookingStatus
  changedBy     String        // userId or system
  changedByRole UserRole
  reason        String?
  createdAt     DateTime      @default(now())

  @@index([bookingId])
  @@index([createdAt])
}

/// Audit trail of every expert offer for a booking. The "single winner" guarantee is enforced inside
/// prisma.$transaction by conditional updateMany (status/assignment must still match the expected pre-state).
model BookingAssignment {
  id           String           @id @default(uuid()) @map("_id")
  bookingId    String
  booking      Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  employeeId   String
  employee     EmployeeProfile  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  method       AssignmentMethod
  status       AssignmentStatus @default(OFFERED)
  assignedBy   String           // userId of provider, or 'SYSTEM' for the auto-assign worker
  reason       String?
  offeredAt    DateTime         @default(now())
  respondedAt  DateTime?

  @@index([bookingId, status])
  @@index([employeeId, status])
  @@index([bookingId, offeredAt])
}

/// Metadata for booking-scoped voice calls. No audio is stored.
model BookingCall {
  id            String      @id @default(uuid()) @map("_id")
  bookingId     String
  booking       Booking     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  channelName   String
  callerUserId  String
  calleeUserId  String
  status        CallStatus  @default(RINGING)
  startedAt     DateTime    @default(now())
  answeredAt    DateTime?
  endedAt       DateTime?
  endReason     String?

  @@index([bookingId, status])
  @@index([calleeUserId, status])
}

// ==========================================
// PAYMENTS & FINANCIALS
// ==========================================

model Payment {
  id              String        @id @default(uuid()) @map("_id")
  bookingId       String
  booking         Booking       @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  transactionRef  String        @unique
  idempotencyKey  String?       @unique
  amount          String
  currency        String        @default("INR")
  status          PaymentStatus @default(PENDING)
  method          PaymentMethod @default(ONLINE)
  gatewayResponse Json?
  createdAt       DateTime      @default(now())

  refunds         Refund[]

  @@index([bookingId])
  @@index([status])
  @@index([createdAt])
}

model Refund {
  id             String       @id @default(uuid()) @map("_id")
  paymentId      String
  payment        Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  bookingId      String
  booking        Booking      @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  idempotencyKey String?      @unique
  amount         String
  reason         String
  status         RefundStatus @default(PENDING)
  processedBy    String       // SUPER_ADMIN userId
  createdAt      DateTime     @default(now())

  @@index([paymentId])
  @@index([bookingId])
  @@index([status])
}

// ==========================================
// REVIEWS & MODERATION
// ==========================================

model Review {
  id          String           @id @default(uuid()) @map("_id")
  bookingId   String?          @unique
  booking     Booking?         @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  customerId  String
  customer    User             @relation("CustomerReviews", fields: [customerId], references: [id], onDelete: Cascade)
  serviceId   String
  service     Service          @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  vendorId    String?
  vendor      VendorProfile?   @relation("VendorReviews", fields: [vendorId], references: [id], onDelete: SetNull)
  employeeId  String?
  employee    EmployeeProfile? @relation("EmployeeReviews", fields: [employeeId], references: [id], onDelete: SetNull)
  rating      Int
  comment     String?
  isHidden    Boolean          @default(false)
  reportCount Int              @default(0)
  createdAt   DateTime         @default(now())

  @@index([serviceId])
  @@index([vendorId])
  @@index([employeeId])
  @@index([isHidden])
}

model EmployeeFeedback {
  id           String          @id @default(uuid()) @map("_id")
  employeeId   String
  employee     EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  userId       String
  user         User            @relation("FeedbackGiven", fields: [userId], references: [id], onDelete: Cascade)
  feedbackType String          @default("General Experience")
  rating       Int             @default(5)
  comment      String?
  createdAt    DateTime        @default(now())

  @@index([employeeId])
}

// ==========================================
// DOCUMENTS & KYC
// ==========================================

model Document {
  id                 String       @id @default(uuid()) @map("_id")
  userId             String
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type               DocumentType
  title              String
  fileUrl            String
  verificationStatus KycStatus    @default(PENDING)
  rejectionReason    String?
  verifiedAt         DateTime?
  createdAt          DateTime     @default(now())

  @@index([userId])
  @@index([verificationStatus])
}

// ==========================================
// NOTIFICATIONS
// ==========================================

model Notification {
  id           String             @id @default(uuid()) @map("_id")
  title        String
  message      String
  target       NotificationTarget @default(ALL)
  targetUserId String?
  isRead       Boolean            @default(false)
  sentAt       DateTime           @default(now())

  @@index([targetUserId])
  @@index([sentAt])
  @@index([targetUserId, isRead, sentAt(sort: Desc)])
}

// ==========================================
// PLATFORM & APP CONFIGURATION
// ==========================================

model PlatformSetting {
  id          String   @id @default(uuid()) @map("_id")
  key         String   @unique
  value       Json
  description String?
  updatedAt   DateTime @updatedAt
}

model AppConfiguration {
  id          String   @id @default(uuid()) @map("_id")
  key         String   @unique
  value       Json
  description String?
  updatedAt   DateTime @updatedAt
}

// ==========================================
// AUDIT LOGGING (IMMUTABLE)
// ==========================================

model AuditLog {
  id           String   @id @default(uuid()) @map("_id")
  superAdminId String
  superAdmin   User     @relation("AdminAuditLogs", fields: [superAdminId], references: [id], onDelete: Restrict)
  action       String   // e.g., CUSTOMER_SUSPENDED, VENDOR_APPROVED, BOOKING_PRICE_OVERRIDDEN
  entityType   String   // e.g., User, Booking, VendorProfile, Service
  entityId     String
  before       Json?
  after        Json?
  changes      Json?
  reason       String?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  @@index([superAdminId])
  @@index([entityType, entityId])
  @@index([createdAt])
}
